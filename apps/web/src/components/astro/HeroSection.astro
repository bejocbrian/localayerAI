---
import { ArrowRight, CheckCircle } from 'lucide-react';
---

<section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-teal-900">
  <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-10"></div>
  <div class="section-padding relative">
    <div class="container">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div class="animate-fade-up">
          <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-teal-500/30 bg-teal-500/10 px-4 py-1.5 text-sm font-medium text-teal-300">
            <CheckCircle class="h-4 w-4" />
            Trusted by 100+ Local Businesses
          </div>
          <h1 class="heading-lg text-white">
            Enterprise-Level Tech for{' '}
            <span class="text-gradient">Local Businesses</span>
          </h1>
          <p class="mt-6 max-w-lg text-lg leading-relaxed text-slate-300">
            Professional web development, business automation, and AI-powered tools — without the enterprise price tag. 
            Grow your business with technology that works.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/schedule" class="btn-primary">
              Schedule a Free Call
              <ArrowRight class="h-4 w-4" />
            </a>
            <a href="/services" class="btn-secondary border-slate-600 bg-slate-800/50 text-white hover:bg-slate-700/50">
              Explore Services
            </a>
          </div>
        </div>

        <div class="animate-fade-in hidden lg:block">
          <div class="grid grid-cols-2 gap-4">
            <div class="space-y-4">
              <div class="rounded-2xl border border-slate-700/50 bg-slate-800/50 p-6 backdrop-blur-sm">
                <div class="text-3xl font-bold text-teal-400">100+</div>
                <div class="mt-1 text-sm text-slate-400">Businesses Served</div>
              </div>
              <div class="rounded-2xl border border-slate-700/50 bg-slate-800/50 p-6 backdrop-blur-sm">
                <div class="text-3xl font-bold text-teal-400">98%</div>
                <div class="mt-1 text-sm text-slate-400">Client Satisfaction</div>
              </div>
            </div>
            <div class="mt-8 space-y-4">
              <div class="rounded-2xl border border-slate-700/50 bg-slate-800/50 p-6 backdrop-blur-sm">
                <div class="text-3xl font-bold text-teal-400">24/7</div>
                <div class="mt-1 text-sm text-slate-400">Support Available</div>
              </div>
              <div class="rounded-2xl border border-slate-700/50 bg-slate-800/50 p-6 backdrop-blur-sm">
                <div class="text-3xl font-bold text-teal-400">48hr</div>
                <div class="mt-1 text-sm text-slate-400">Avg. Delivery</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
