---
import { ArrowRight } from 'lucide-react';
---

<section class="section-padding bg-gradient-to-br from-teal-600 to-teal-700">
  <div class="container text-center">
    <h2 class="heading-md text-white">Ready to Grow Your Business?</h2>
    <p class="mx-auto mt-4 max-w-lg text-lg text-teal-100">
      Schedule a free consultation call. We'll discuss your business goals and how we can help you achieve them.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/schedule" class="inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-semibold text-teal-700 shadow-sm transition-all hover:bg-teal-50 hover:shadow-md">
        Schedule a Free Call
        <ArrowRight class="h-4 w-4" />
      </a>
      <a href="/contact" class="inline-flex items-center gap-2 rounded-xl border border-teal-500/30 px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-teal-600/50">
        Send Us a Message
      </a>
    </div>
  </div>
</section>
