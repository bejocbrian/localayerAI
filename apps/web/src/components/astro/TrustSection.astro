---
import { Shield, Clock, Headphones, Award } from 'lucide-react';
---

<section class="section-padding bg-slate-50">
  <div class="container">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="heading-md">Why Choose Localayer AI</h2>
      <p class="mt-4 text-lg text-slate-600">
        We combine enterprise expertise with small-town care.
      </p>
    </div>

    <div class="mt-16 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      <div class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-teal-100 text-teal-600">
          <Shield class="h-6 w-6" />
        </div>
        <h3 class="mt-4 text-lg font-semibold text-slate-900">No Contracts</h3>
        <p class="mt-2 text-sm text-slate-600">Month-to-month. Cancel anytime. We earn your business every month.</p>
      </div>
      <div class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-teal-100 text-teal-600">
          <Clock class="h-6 w-6" />
        </div>
        <h3 class="mt-4 text-lg font-semibold text-slate-900">Fast Delivery</h3>
        <p class="mt-2 text-sm text-slate-600">Most projects completed in under 2 weeks. We respect your timeline.</p>
      </div>
      <div class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-teal-100 text-teal-600">
          <Headphones class="h-6 w-6" />
        </div>
        <h3 class="mt-4 text-lg font-semibold text-slate-900">Ongoing Support</h3>
        <p class="mt-2 text-sm text-slate-600">We're always a call or email away. Real humans, real help.</p>
      </div>
      <div class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-teal-100 text-teal-600">
          <Award class="h-6 w-6" />
        </div>
        <h3 class="mt-4 text-lg font-semibold text-slate-900">Proven Results</h3>
        <p class="mt-2 text-sm text-slate-600">100+ businesses served. 98% satisfaction rate. Results that speak.</p>
      </div>
    </div>
  </div>
</section>
