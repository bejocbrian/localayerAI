---
import MainLayout from '../layouts/MainLayout.astro';
import { ArrowLeft } from 'lucide-react';
---

<MainLayout title="Page Not Found">
  <section class="section-padding flex min-h-[60vh] items-center bg-white">
    <div class="container text-center">
      <div class="text-8xl font-bold text-teal-600">404</div>
      <h1 class="mt-4 heading-md text-slate-900">Page Not Found</h1>
      <p class="mt-4 text-lg text-slate-600">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a href="/" class="btn-primary mt-8 inline-flex items-center gap-2">
        <ArrowLeft class="h-4 w-4" />
        Back to Home
      </a>
    </div>
  </section>
</MainLayout>
