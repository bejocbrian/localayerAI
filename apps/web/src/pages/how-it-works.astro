---
import MainLayout from '../layouts/MainLayout.astro';
import { STEPS } from '../config/constants.js';
import { Phone, FileText, Rocket, HeartHandshake, ArrowRight, CheckCircle, Clock, MessageCircle, Shield } from 'lucide-react';
import CTASection from '../components/astro/CTASection.astro';

const stepIcons = { 1: Phone, 2: FileText, 3: Rocket, 4: HeartHandshake };

const stepDetails = [
  { 
    expect: "A 15-minute friendly chat — no sales pressure, no jargon.",
    deliverable: null,
    time: "15 minutes",
  },
  { 
    expect: "A detailed, transparent breakdown of exactly what you'll get and what it costs.",
    deliverable: "Fixed-price proposal",
    time: "Within 24 hours",
  },
  { 
    expect: "Regular updates, previews, and a launch date you can count on.",
    deliverable: "Live, finished product",
    time: "1–2 weeks avg.",
  },
  { 
    expect: "We don't disappear after launch. Tweaks, updates, and support are always included.",
    deliverable: "Ongoing partnership",
    time: "Always on",
  },
];

const faqs = [
  { q: "How long does the whole process take?", a: "Most projects launch within 1–2 weeks from the discovery call. Simple sites can go live in as little as 5 days." },
  { q: "Do I need to sign a long-term contract?", a: "No. You pay for what you get, and you own everything. Ongoing services like SEO or ads are month-to-month." },
  { q: "What if I'm not happy with the result?", a: "We offer revisions at every stage. Your satisfaction is non-negotiable — we'll keep working until you're thrilled." },
  { q: "Do you work with businesses outside the US?", a: "We primarily serve US-based local businesses, but we're happy to chat if you're elsewhere." },
];
---

<MainLayout
  title="How It Works"
  description="Simple 4-step process to get your local business online. Free discovery call, custom proposal, fast build, and ongoing support. No contracts, no surprises."
>

  <section class="section-padding bg-gradient-to-br from-slate-900 to-slate-800">
    <div class="container">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="heading-lg text-white">Getting Started Is Easy</h1>
        <p class="mt-4 text-lg text-slate-300">
          Four simple steps from "I need a website" to "my business is online and growing." No contracts, no surprises, no jargon.
        </p>
        <div class="mt-6 inline-flex items-center gap-6 text-sm text-slate-400">
          <span class="flex items-center gap-1.5"><Clock class="h-4 w-4 text-teal-400" /> 15-min call</span>
          <span class="flex items-center gap-1.5"><FileText class="h-4 w-4 text-teal-400" /> Fixed pricing</span>
          <span class="flex items-center gap-1.5"><Rocket class="h-4 w-4 text-teal-400" /> Fast launch</span>
          <span class="flex items-center gap-1.5"><Shield class="h-4 w-4 text-teal-400" /> No contracts</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline Steps -->
  <section class="section-padding bg-white">
    <div class="container">
      <div class="mx-auto max-w-3xl">
        {STEPS.map((step, idx) => {
          const Icon = stepIcons[step.number] || Phone;
          const detail = stepDetails[idx];
          const isLast = idx === STEPS.length - 1;
          return (
            <div class="relative flex gap-6 md:gap-10">
              {/* Timeline line */}
              <div class="flex flex-col items-center">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-teal-600 text-white shadow-lg shadow-teal-600/25">
                  <Icon class="h-6 w-6" />
                </div>
                {!isLast && (
                  <div class="w-0.5 flex-1 bg-gradient-to-b from-teal-200 to-slate-100" />
                )}
              </div>

              {/* Content */}
              <div class:list={['pb-12', isLast && 'pb-0']}>
                <div class="flex flex-wrap items-center gap-3">
                  <span class="rounded-full bg-teal-50 px-2.5 py-0.5 text-xs font-bold text-teal-700">
                    Step {step.number}
                  </span>
                  <span class="text-xs text-slate-400">{detail.time}</span>
                </div>
                <h3 class="mt-2 text-xl font-bold text-slate-900">{step.title}</h3>
                <p class="mt-2 text-slate-600 leading-relaxed">{step.description}</p>
                <p class="mt-2 text-sm text-slate-500">{detail.expect}</p>
                {detail.deliverable && (
                  <div class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700">
                    <CheckCircle class="h-3 w-3" /> You get: {detail.deliverable}
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>

      <div class="mt-16 text-center">
        <a href="/schedule" class="btn-primary text-base">
          Book Your Free Discovery Call <ArrowRight class="h-4 w-4" />
        </a>
        <p class="mt-3 text-sm text-slate-500">No commitment required. 100% free.</p>
      </div>
    </div>
  </section>

  <!-- What You Get -->
  <section class="section-padding bg-slate-50">
    <div class="container">
      <div class="mx-auto max-w-2xl text-center mb-10">
        <h2 class="heading-md">What You Get With Every Project</h2>
        <p class="mt-3 text-slate-600">No matter which services you choose, every project includes these guarantees.</p>
      </div>
      <div class="mx-auto grid max-w-4xl gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl bg-white p-5 text-center shadow-sm">
          <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-xl bg-teal-50">
            <MessageCircle class="h-5 w-5 text-teal-600" />
          </div>
          <h3 class="mt-3 text-sm font-bold text-slate-900">Dedicated Point of Contact</h3>
          <p class="mt-1 text-xs text-slate-500">One person who knows your project inside and out.</p>
        </div>
        <div class="rounded-2xl bg-white p-5 text-center shadow-sm">
          <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-xl bg-teal-50">
            <Clock class="h-5 w-5 text-teal-600" />
          </div>
          <h3 class="mt-3 text-sm font-bold text-slate-900">On-Time Delivery</h3>
          <p class="mt-1 text-xs text-slate-500">We hit our deadlines, period. Or we refund you.</p>
        </div>
        <div class="rounded-2xl bg-white p-5 text-center shadow-sm">
          <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-xl bg-teal-50">
            <Shield class="h-5 w-5 text-teal-600" />
          </div>
          <h3 class="mt-3 text-sm font-bold text-slate-900">You Own Everything</h3>
          <p class="mt-1 text-xs text-slate-500">No lock-in. All code, content, and accounts are yours.</p>
        </div>
        <div class="rounded-2xl bg-white p-5 text-center shadow-sm">
          <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-xl bg-teal-50">
            <HeartHandshake class="h-5 w-5 text-teal-600" />
          </div>
          <h3 class="mt-3 text-sm font-bold text-slate-900">Post-Launch Support</h3>
          <p class="mt-1 text-xs text-slate-500">Free tweaks and support after launch — we're not done until you're happy.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-padding bg-white">
    <div class="container">
      <div class="mx-auto max-w-2xl text-center mb-10">
        <h2 class="heading-md">Common Questions</h2>
      </div>
      <div class="mx-auto max-w-2xl space-y-4">
        {faqs.map((faq) => (
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <h3 class="text-sm font-bold text-slate-900">{faq.q}</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</MainLayout>
