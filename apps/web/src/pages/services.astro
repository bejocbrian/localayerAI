---
import MainLayout from '../layouts/MainLayout.astro';
import { SERVICES } from '../config/constants.js';
import { Globe, Zap, Settings, Bot, MapPin, Share2, Target, Mail, Star, ShoppingCart, Smartphone, Video, Headphones, CheckCircle, ArrowRight } from 'lucide-react';
import CTASection from '../components/astro/CTASection.astro';

const iconMap = {
  globe: Globe,
  zap: Zap,
  settings: Settings,
  bot: Bot,
  mappin: MapPin,
  share2: Share2,
  target: Target,
  mail: Mail,
  star: Star,
  shoppingcart: ShoppingCart,
  smartphone: Smartphone,
  video: Video,
  headphones: Headphones,
};

const gradients = [
  "from-blue-500 to-blue-600",
  "from-violet-500 to-violet-600",
  "from-amber-500 to-amber-600",
  "from-emerald-500 to-emerald-600",
  "from-rose-500 to-rose-600",
  "from-cyan-500 to-cyan-600",
  "from-orange-500 to-orange-600",
  "from-pink-500 to-pink-600",
  "from-teal-500 to-teal-600",
  "from-indigo-500 to-indigo-600",
  "from-fuchsia-500 to-fuchsia-600",
  "from-lime-500 to-lime-600",
  "from-red-500 to-red-600",
];

const bgColors = [
  "bg-blue-50", "bg-violet-50", "bg-amber-50", "bg-emerald-50",
  "bg-rose-50", "bg-cyan-50", "bg-orange-50", "bg-pink-50",
  "bg-teal-50", "bg-indigo-50", "bg-fuchsia-50", "bg-lime-50", "bg-red-50",
];

const textColors = [
  "text-blue-600", "text-violet-600", "text-amber-600", "text-emerald-600",
  "text-rose-600", "text-cyan-600", "text-orange-600", "text-pink-600",
  "text-teal-600", "text-indigo-600", "text-fuchsia-600", "text-lime-600", "text-red-600",
];
---

<MainLayout
  title="Our Services"
  description="Web development, business automation, AI chatbots, Google Business Profile optimization, paid ads management, social media, and 13+ digital services for local businesses."
>

  <section class="section-padding bg-gradient-to-br from-slate-900 to-slate-800">
    <div class="container">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="heading-lg text-white">Everything Your Business Needs to Grow Online</h1>
        <p class="mt-4 text-lg text-slate-300">
          From websites to AI chatbots to ad management — we handle the tech so you can focus on what you do best.
        </p>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="container">
      <div class="mx-auto max-w-2xl text-center mb-12">
        <h2 class="heading-md">Digital Services Built for Local Businesses</h2>
        <p class="mt-3 text-slate-600">Each service is designed to solve a real problem and deliver measurable results.</p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {SERVICES.map((service, idx) => {
          const Icon = iconMap[service.icon] || Globe;
          return (
            <div class="group rounded-2xl border border-slate-200 bg-white p-6 transition-all duration-300 hover:border-slate-300 hover:shadow-lg hover:shadow-slate-200/50">
              <div class:list={['flex h-12 w-12 items-center justify-center rounded-xl', bgColors[idx]]}>
                <Icon class:list={['h-6 w-6', textColors[idx]]} />
              </div>
              <h3 class="mt-4 text-lg font-bold text-slate-900">{service.title}</h3>
              <p class:list={['mt-1 text-sm font-medium', textColors[idx]]}>{service.subtitle}</p>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{service.description}</p>
              <ul class="mt-4 space-y-2">
                {service.features.slice(0, 4).map((feature) => (
                  <li class="flex items-start gap-2 text-sm text-slate-600">
                    <CheckCircle class="mt-0.5 h-4 w-4 shrink-0 text-teal-500" />
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-5 pt-4 border-t border-slate-100">
                <a href="/schedule" class="inline-flex items-center gap-1.5 text-sm font-semibold text-teal-600 transition-colors hover:text-teal-700">
                  Get a Custom Quote <ArrowRight class="h-3.5 w-3.5" />
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section-padding bg-slate-50">
    <div class="container">
      <div class="mx-auto max-w-2xl text-center mb-10">
        <h2 class="heading-md">Not Sure What You Need?</h2>
        <p class="mt-3 text-slate-600">
          Book a free 15-minute consultation. We'll learn about your business and recommend the right services — no pressure, no jargon.
        </p>
        <a href="/schedule" class="btn-primary mt-6">
          Schedule a Free Consultation <ArrowRight class="h-4 w-4" />
        </a>
      </div>

      <div class="mx-auto grid max-w-3xl gap-6 sm:grid-cols-3">
        <div class="rounded-2xl bg-white p-6 text-center shadow-sm">
          <div class="text-3xl font-bold text-teal-600">13+</div>
          <p class="mt-1 text-sm font-medium text-slate-900">Services Available</p>
          <p class="mt-1 text-xs text-slate-500">Everything from web dev to AI</p>
        </div>
        <div class="rounded-2xl bg-white p-6 text-center shadow-sm">
          <div class="text-3xl font-bold text-teal-600">48hr</div>
          <p class="mt-1 text-sm font-medium text-slate-900">Average Setup Time</p>
          <p class="mt-1 text-xs text-slate-500">Most projects launch fast</p>
        </div>
        <div class="rounded-2xl bg-white p-6 text-center shadow-sm">
          <div class="text-3xl font-bold text-teal-600">24/7</div>
          <p class="mt-1 text-sm font-medium text-slate-900">Ongoing Support</p>
          <p class="mt-1 text-xs text-slate-500">We're always here for you</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</MainLayout>
