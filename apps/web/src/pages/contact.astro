---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE } from '../config/constants.js';
import { Mail, Calendar } from 'lucide-react';
---

<MainLayout
  title="Contact"
  description="Get in touch with Localayer AI. Schedule a free consultation call. We respond within 24 hours. Contact: contact@localayerai.com"
>
  <section class="section-padding bg-gradient-to-br from-slate-900 to-slate-800">
    <div class="container">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="heading-lg text-white">Get In Touch</h1>
        <p class="mt-4 text-lg text-slate-300">
          Have a question or ready to get started? We'd love to hear from you.
        </p>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="container">
      <div class="mx-auto max-w-2xl text-center">
        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-teal-100 text-teal-600 mx-auto">
          <Calendar class="h-7 w-7" />
        </div>
        <h2 class="mt-6 heading-sm">Schedule a Free Consultation</h2>
        <p class="mt-3 text-slate-600">
          Book a no-obligation 15-minute call. We'll learn about your business, answer your questions, and show you what's possible.
        </p>
        <a href="/schedule" class="mt-8 inline-flex items-center gap-2 rounded-xl bg-teal-600 px-8 py-4 text-base font-semibold text-white shadow-sm transition-all hover:bg-teal-700 hover:shadow-md">
          <Calendar class="h-5 w-5" />
          Schedule a Call
        </a>

        <div class="mt-12 grid gap-8 sm:grid-cols-2 text-left">
          <div class="flex items-start gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-teal-100 text-teal-600">
              <Mail class="h-5 w-5" />
            </div>
            <div>
              <h3 class="font-semibold text-slate-900">Email</h3>
              <p class="text-sm text-slate-600">{SITE.email}</p>
            </div>
          </div>

          <div>
            <h3 class="font-semibold text-slate-900">Business Hours</h3>
            <div class="mt-2 space-y-1 text-sm text-slate-600">
              <div class="flex justify-between">
                <span>Mon - Fri</span>
                <span class="font-medium text-slate-900">9:00 AM - 6:00 PM</span>
              </div>
              <div class="flex justify-between">
                <span>Saturday</span>
                <span class="font-medium text-slate-900">10:00 AM - 4:00 PM</span>
              </div>
              <div class="flex justify-between">
                <span>Sunday</span>
                <span class="font-medium text-slate-900">Closed</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
