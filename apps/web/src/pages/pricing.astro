---
import MainLayout from '../layouts/MainLayout.astro';
import { PRICING_PLANS } from '../config/constants.js';
import { Check, ArrowRight } from 'lucide-react';
import PricingBuilder from '../components/react/PricingBuilder.jsx';
import CTASection from '../components/astro/CTASection.astro';
---

<MainLayout
  title="Pricing"
  description="Simple, transparent pricing for web development, automation, and digital services. Starter from $499, Professional, and Enterprise plans. Build your custom package."
>
  <section class="section-padding bg-gradient-to-br from-slate-900 to-slate-800">
    <div class="container">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="heading-lg text-white">Simple, Transparent Pricing</h1>
        <p class="mt-4 text-lg text-slate-300">
          No hidden fees. No surprises. Just honest pricing for exceptional service.
        </p>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="container">
      <div class="grid gap-8 md:grid-cols-3">
        {Object.values(PRICING_PLANS).map((plan) => (
          <div class:list={[
            'card relative',
            plan.highlighted && 'border-teal-600 shadow-lg shadow-teal-600/10'
          ]}>
            {plan.highlighted && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-teal-600 px-4 py-1 text-xs font-semibold text-white">
                Most Popular
              </div>
            )}
            <h3 class="text-xl font-bold text-slate-900">{plan.name}</h3>
            <p class="mt-1 text-sm text-slate-600">{plan.description}</p>
            <ul class="mt-6 space-y-3">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-3 text-sm text-slate-600">
                  <Check class="mt-0.5 h-4 w-4 shrink-0 text-teal-500" />
                  {feature}
                </li>
              ))}
            </ul>
            <a
              href="/schedule"
              class:list={[
                'mt-8 flex items-center justify-center gap-2 w-full',
                plan.highlighted ? 'btn-primary' : 'btn-secondary'
              ]}
            >
              Get Started <ArrowRight class="h-4 w-4" />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-slate-50">
    <div class="container">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="heading-md">Build Your Custom Package</h2>
        <p class="mt-4 text-lg text-slate-600">
          Mix and match services to create the perfect solution for your business.
        </p>
      </div>
      <div class="mt-12">
        <PricingBuilder client:load />
      </div>
    </div>
  </section>

  <CTASection />
</MainLayout>
